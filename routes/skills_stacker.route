# Stacker, Autonomous Skills – Zoll, Grad, Namen aus field/field.json
# v1 (A-05): erst von der Wand wegfahren, Loader RED_2 (Nord) für den Stacker, damit sich die Wege nicht kreuzen; 9 Zyklen füllen die Zeit bis 52 s.
target_p10 120
start    START_STACKER
goto     pose x=-45 y=0 h=0 timeout=2.0
cycle    source=preload  goal=RED_ALLIANCE_1  level=auto
repeat 9 {
  goto   LOADER_RED_2     tol=1.5  timeout=3.0
  intake until=unit       timeout=2.5
  cycle  goal=NEUTRAL_R1  level=auto  timeout=6.0
}
at 52s   goto MIDFIELD_S  timeout=6.0
end      hold
